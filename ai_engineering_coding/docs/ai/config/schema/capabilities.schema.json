{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering-coding.local/docs/ai/config/schema/capabilities.schema.json",
  "title": "V3 capability registry",
  "description": "Schema for docs/ai/config/capabilities.yaml. Declarations do not authorize execution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "capabilities"],
  "properties": {
    "version": { "const": 3 },
    "capabilities": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/capability_identifier" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["providers"],
        "properties": {
          "providers": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/provider" }
          }
        }
      }
    }
  },
  "$defs": {
    "capability_identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_type", "identifier", "availability", "authority", "deterministic"],
      "properties": {
        "provider_type": { "enum": ["agent", "local_tool", "external_tool", "human", "hybrid"] },
        "identifier": { "$ref": "#/$defs/capability_identifier" },
        "availability": { "enum": ["configured", "detected", "unavailable", "unknown"] },
        "authority": { "$ref": "#/$defs/capability_identifier" },
        "deterministic": { "type": "boolean" },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9._:/@+= -]+$",
          "description": "Opaque command reference without interpolation or shell-control syntax."
        },
        "tool_reference": { "$ref": "#/$defs/capability_identifier" },
        "network_requirement": { "enum": ["none", "optional", "required"] }
      },
      "allOf": [
        {
          "if": { "properties": { "provider_type": { "enum": ["local_tool", "external_tool"] } }, "required": ["provider_type"] },
          "then": { "anyOf": [ { "required": ["command"] }, { "required": ["tool_reference"] } ] }
        }
      ]
    }
  }
}
